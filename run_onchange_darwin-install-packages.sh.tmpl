{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash

/opt/homebrew/bin/brew bundle --file=/dev/stdin <<EOF
{{ range .darwin.brews -}}
brew {{ . | quote }}
{{ end -}}
{{ range .darwin.casks -}}
cask {{ . | quote }}
{{ end -}}
{{ if .company -}}
{{ with index . .company -}}
## {{ $.company }}
{{ range .brews -}}
brew {{ . | quote }}
{{ end -}}
{{ range .casks -}}
cask {{ . | quote }}
{{ end -}}
{{ end -}}
{{ end -}}
{{ if .personal -}}
## personal
{{ range .personal_apps.casks -}}
cask {{ . | quote }}
{{ end -}}
{{ end -}}
EOF
{{ end -}}
