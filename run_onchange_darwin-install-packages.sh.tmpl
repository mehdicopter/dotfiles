{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash

/opt/homebrew/bin/brew bundle --file=/dev/stdin <<EOF
{{ range .darwin.brews -}}
brew {{ . | quote }}
{{ end -}}
{{ range .darwin.casks -}}
cask {{ . | quote }}
{{ end -}}
{{ if .company -}}
{{ with index . .company -}}
## {{ $.company }}
{{ range .brews -}}
brew {{ . | quote }}
{{ end -}}
{{ range .casks -}}
cask {{ . | quote }}
{{ end -}}
{{ end -}}
{{ end -}}
{{ if .personal -}}
## personal
{{ range .personal_apps.casks -}}
cask {{ . | quote }}
{{ end -}}
{{ end -}}
EOF

# Homebrew may have just upgraded gnupg. A gpg-agent started before the upgrade
# keeps running against a deleted Cellar prefix and fails to spawn pinentry
# ("gpg: signing failed: No pinentry"), until the next login. Restart it so the
# agent always matches the installed gnupg.
if [ -x /opt/homebrew/bin/gpgconf ] && pgrep -qx gpg-agent; then
  /opt/homebrew/bin/gpgconf --kill gpg-agent
  /opt/homebrew/bin/gpgconf --launch gpg-agent
fi
{{ end -}}
